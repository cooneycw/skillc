__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/
evals/results/
# Local `make verify` run logs (#134); CI does not produce this directory.
reports/

# A flow:auto run's local state, not repository content (#134 item 6): a
# `git add -A` picked up .claude/runs/finish-<id>.json on #127 / PR #128.
.claude/runs/

# Secrets. Nothing here is tracked; this keeps it that way (#23).
.env
.env.*
*.pem
*.key
*.p12
secrets.*
# ...except a Python MODULE inside a vendored upstream snapshot (#356): CPP's
# `lib/security/modules/secrets.py` is the secrets scanner, not a secret, and
# `secrets.*` silently kept it out of tests/fixtures/profile-cpp-codex-flow-
# check-ea6dbfa/, so the cold-container import failed. Scoped to fixtures and
# to `.py` only; tests/test_profile_fixture_completeness.py proves the rule
# still ignores secrets.json/.yaml and a top-level secrets.py.
!tests/fixtures/**/secrets.py
# .claude/security.yml is tracked on purpose (#159): it holds only planted
# canary values. The ignore stays because CPP's gate flags its absence.
.claude/security.yml
