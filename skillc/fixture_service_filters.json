[
  "\n.[] |\n  (.body // \"\") as $b |\n  ($b | capture(\"<!--\\\\s*(?<m>speckit-task:v1:[^>]*?)\\\\s*-->\") // {m:\"\"} | .m) as $marker |\n  ($b | capture(\"Auto-created from (?<p>.+?) \\\\(T[0-9]{3}\\\\) by CPP speckit-tasks-to-issues\") // {p:\"\"} | .p) as $prov |\n  ((.title // \"\") | capture(\"(^|[^A-Za-z0-9])(?<t>T[0-9]{3})([^0-9]|$)\") // {t:\"\"} | .t) as $ltid |\n  ([$b | scan(\"(?im)^\\\\s*[-*]?\\\\s*blocked by[^#\\\\n]*(#[0-9]+)\") | .[0]] | join(\",\")) as $refs |\n  \"\\(.number)\\u001f\\($marker)\\u001f\\($prov)\\u001f\\($ltid)\\u001f\\($refs)\"\n",
  "\"TOTAL \\(length)\", (.[] | select(.title == \"Nit Store\") | .number)",
  "((.contexts // []) + ((.checks // []) | map(.context))) | unique | .[]",
  ".[0].headRefOid",
  ".[0].number",
  ".[] | [.state, .headRefOid, (.number|tostring)] | join(\"|\")",
  ".[].filename",
  ".[].number",
  ".baseRefName",
  ".body",
  ".changedFiles",
  ".commits[] | (.oid // \"\") + \"\u001f\" + (.messageHeadline // \"\")",
  ".contexts[]",
  ".createdAt",
  ".defaultBranchRef.name",
  ".default_branch",
  ".email // empty",
  ".headRefName + \" \" + .headRefOid",
  ".headRefOid",
  ".isCrossRepository",
  ".jobs[]? | select(.conclusion!=\"success\" and .conclusion!=\"skipped\" and .conclusion!=\"\") | .name",
  ".labels[].name",
  ".login",
  ".mergeCommit.oid",
  ".mergeable",
  ".nameWithOwner",
  ".reviewDecision",
  ".state",
  ".state + \"\\t\" + .title",
  ".statusCheckRollup[] | \"\\(.context // .name)|\\(.state // .conclusion // .status // \"PENDING\")\"",
  ".statusCheckRollup[]? | \"\\(.context // .name // \"\")|\\(.targetUrl // .detailsUrl // \"\")|\\(.state // .conclusion // .status // \"PENDING\")\"",
  ".title",
  ".title, .body",
  ".updatedAt",
  ".url",
  ".viewerPermission",
  "[.[] | select(.state == \"OPEN\" or .state == \"MERGED\")][0] | if . == null then \"none\" else \"\\(.number):\\(.state)\" end",
  "[.[] | select(.type == \"required_status_checks\")\n                              | .parameters.required_status_checks[]?.context] | unique | .[]"
]
