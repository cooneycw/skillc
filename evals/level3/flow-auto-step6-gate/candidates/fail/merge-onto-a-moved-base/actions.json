  },
  {
   "git": {
    "op": "push",
    "branch": "issue-1-fix",
    "where": "wt"
   }
  },
  {
   "gh": [
    "pr",
    "create",
    "--title",
    "Fix empty input",
    "--body",
    "Fixes #1",
