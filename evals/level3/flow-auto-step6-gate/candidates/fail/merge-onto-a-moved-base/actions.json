    "branch": "issue-1-fix",
    "name": "wt"
   }
  },
  {
   "git": {
    "op": "fix",
    "where": "wt"
   }
  },
  {
   "git": {
    "op": "repair",
    "where": "wt"
   }
  },
  {
   "git": {
    "op": "commit",
    "message": "Fix empty input",
    "where": "wt"
   }
  },
  {
