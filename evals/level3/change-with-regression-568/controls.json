  "mutations": {"csv-only": {"old": "    rows = list(_rows(path, kind))", "new": "    if kind == \"jsonl\":\n        raise ValueError(\"input: unsupported jsonl\")\n    rows = list(_rows(path, kind))"}, "jsonl-only": {"old": "    rows = list(_rows(path, kind))", "new": "    if kind == \"csv\":\n        raise ValueError(\"input: unsupported csv\")\n    rows = list(_rows(path, kind))"}, "partial": {"old": "    rows = list(_rows(path, kind))\n    c = connect(db_path)\n    try:\n        with c:\n            for sku, quantity in rows:\n                _put(c, sku, quantity)\n    finally:\n        c.close()\n    return len({sku for sku, _ in rows})", "new": "    seen = set()\n    for sku, quantity in _rows(path, kind):\n        set_quantity(db_path, sku, quantity)\n        seen.add(sku)\n    return len(seen)"}, "replace": {"old": "INSERT INTO items VALUES (?, ?, '', ?) ON CONFLICT(sku) DO UPDATE SET quantity=excluded.quantity", "new": "INSERT OR REPLACE INTO items VALUES (?, ?, '', ?)"}, "first-wins": {"old": "for sku, quantity in rows:", "new": "for sku, quantity in reversed(rows):"}, "boolean": {"old": "type(quantity) is not int", "new": "not isinstance(quantity, int)"}, "metadata": {"old": "INSERT INTO items VALUES (?, ?, '', ?) ON CONFLICT(sku) DO UPDATE SET quantity=excluded.quantity", "new": "INSERT INTO items VALUES (?, ?, '', ?) ON CONFLICT(sku) DO UPDATE SET quantity=excluded.quantity, note=excluded.note, created_id=excluded.created_id"}},
